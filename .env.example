# App Config & CORS Setup
APP_URL="http://localhost:5173"
VITE_API_URL="http://localhost:3000" # On Vercel/Render frontend, set to your backend API URL (e.g. https://vivi-shop-express.onrender.com)
VITE_PYTHON_API_URL="http://localhost:8000"
CORE_ORIGIN="http://localhost:5173,https://vivi-shop-frontend.onrender.com,https://vivi-shop.vercel.app" # Comma-separated allowed frontend origins for CORS

# Resend Email Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key"
VITE_RESEND_API_KEY="re_your_resend_api_key"

# Set your verified sender email or use Resend's testing sender: "Vivi Shop <onboarding@resend.dev>"
FROM_EMAIL="Vivi Shop <onboarding@resend.dev>"
ADMIN_EMAIL="admin@example.com"
VITE_ADMIN_EMAIL="admin@example.com"

# Payment
PAYSTACK_SECRET_KEY="sk_test_..."
VITE_PAYSTACK_PUBLIC_KEY="pk_test_..."

# Cloudinary Configuration (Optional - falls back to image data URL if unconfigured)
VITE_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
VITE_CLOUDINARY_UPLOAD_PRESET="ml_default"

# Firebase Service Account Credentials for Backend Services (Node.js & Python FastAPI)
# Option 1: File path relative to project root
FIREBASE_SERVICE_ACCOUNT_KEY="./backend/service-account.json"

# Option 2: Full JSON string for production deployments (e.g., Render, Vercel environment variables)
# Set FIREBASE_SERVICE_ACCOUNT_KEY or FIREBASE_SERVICE_ACCOUNT_JSON in Render dashboard with your Firebase Service Account JSON string:
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"shopsy-ea9e4","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@shopsy-ea9e4.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}'

# Database & Environment
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shop"
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
