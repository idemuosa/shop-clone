{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/products/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/categories/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|products/|categories/).*)",
      "destination": "/index.html"
    }
  ]
}
